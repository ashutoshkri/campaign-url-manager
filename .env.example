# Port the server listens on
PORT=4000

# SQLite database file (created automatically)
DB_PATH=data/campaigns.db

# Public base used to build tracking URLs, e.g. https://track.example.com
# Leave empty to use the host the dashboard is opened on.
PUBLIC_BASE_URL=

# Dashboard login (HTTP Basic Auth). Tracking URLs (/go/...) stay public.
# Leave ADMIN_PASSWORD empty to disable login for local testing.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Set to true when running behind a reverse proxy (Render, Nginx, etc.)
# so visitor IPs and https are detected correctly.
TRUST_PROXY=false
